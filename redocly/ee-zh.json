{
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "description": "API key as username and API secret as password. Manage keys in the dashboard or via 'emqx ctl api_keys'.",
        "scheme": "basic",
        "type": "http"
      },
      "bearerAuth": {
        "description": "JWT obtained from POST /api/v5/login.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Authenticate via one of the security schemes to retrieve the full specification, or create an API key in the dashboard.",
    "title": "EMQX API",
    "version": "unknown"
  },
  "openapi": "3.0.0",
  "paths": {
    "/login": {
      "post": {
        "responses": {
          "200": {
            "description": "Bearer token returned in the response body."
          }
        },
        "security": [],
        "summary": "Obtain a bearer token.",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Plain-text 'emqx is running' when the broker is up."
          }
        },
        "security": [],
        "summary": "Broker health check.",
        "tags": [
          "Status"
        ]
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    },
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "/api/v5"
    }
  ]
}
